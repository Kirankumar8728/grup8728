# ==============================================================================
# GROUPLINKS PLATFORM ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & GEMINI ENGINES
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls (smart category classification, tag generation, metadata enrichment).
# In AI Studio, this is automatically injected at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. CANONICAL SITE URLS
# ------------------------------------------------------------------------------
# SITE_URL: Canonical site domain URL used on the server for sitemaps, RSS feeds, robots.txt, canonical links, OpenGraph, and JSON-LD structured data.
SITE_URL=https://grouplinks.app

# NEXT_PUBLIC_SITE_URL: Client-side accessible site URL for sharing links, dynamic social cards, and relative asset resolution in the browser.
NEXT_PUBLIC_SITE_URL=https://grouplinks.app

# ------------------------------------------------------------------------------
# 3. HOSTINGER SMTP / STANDARD EMAIL ENGINE
# ------------------------------------------------------------------------------
# SMTP_HOST: Hostinger Mail SMTP server host (default: smtp.hostinger.com).
SMTP_HOST=smtp.hostinger.com

# SMTP_PORT: SMTP server port (465 for SSL/TLS, 587 for STARTTLS).
SMTP_PORT=465

# SMTP_SECURE: Set to true for SSL/TLS on port 465, false for STARTTLS on port 587.
SMTP_SECURE=true

# SMTP_USER: SMTP account username/email address for authenticating with Hostinger Mail.
SMTP_USER=noreply@grouplinks.app

# SMTP_PASS: Password for the SMTP mailbox account.
SMTP_PASS=

# SMTP_FROM: Default sender display name and email address for SMTP mail dispatch.
SMTP_FROM="GroupLinks <noreply@grouplinks.app>"

# ------------------------------------------------------------------------------
# 4. NATIVE MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DB_HOST: Hostname or IP address for the native MySQL database (e.g. localhost or Hostinger MySQL server).
DB_HOST=localhost

# DB_USER: Database username created in Hostinger hPanel or local MySQL.
DB_USER=u123456789_grouplinks

# DB_PASSWORD: Password for the MySQL database user.
DB_PASSWORD=your_secure_db_password

# DB_NAME: MySQL database name storing group records, users, and statistics.
DB_NAME=u123456789_groups_db

# DB_PORT: MySQL server port (default 3306).
DB_PORT=3306

# ------------------------------------------------------------------------------
# 5. ADMINISTRATOR AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# ADMIN_EMAIL: Master administrator email address authorized to log in at /kiran8728 and /admin.
ADMIN_EMAIL=kirankumar8728@gmail.com

# ADMIN_USERNAME: Master administrator username for admin portal login (defaults to admin).
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: Master administrator password for portal access (/kiran8728 and /admin).
ADMIN_PASSWORD=

# ADMIN_TOTP_SECRET: Base32 secret key for Google Authenticator / 2FA TOTP code generation.
ADMIN_TOTP_SECRET=

# ADMIN_SESSION_SECRET: Cryptographic HMAC secret key used to sign and verify secure admin session tokens.
ADMIN_SESSION_SECRET=

# ADMIN_BACKUP_CODES: Comma-separated list of emergency backup codes for 2FA bypass.
ADMIN_BACKUP_CODES=

# ------------------------------------------------------------------------------
# 6. BOT & AUTOMATED CRON SECURITY KEYS
# ------------------------------------------------------------------------------
# BOT_API_KEY: Secret API key for authorizing automated background bot scrapers and import scripts.
BOT_API_KEY=

# CRON_SECRET: Bearer token secret required to execute automated cron jobs (e.g. /api/cron/indexnow, sitemap regeneration).
CRON_SECRET=

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID KEYS)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: Web Push VAPID Public Key for client-side browser push notification subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID_PRIVATE_KEY: Web Push VAPID Private Key for server-side push notification dispatch.
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 8. GOOGLE ANALYTICS 4 (GA4)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID: Google Analytics 4 (GA4) Measurement ID (e.g. G-12345678) for client-side tracking.
NEXT_PUBLIC_GA_ID=G-12345678

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE R2 OBJECT STORAGE (cdn.grouplinks.app)
# ------------------------------------------------------------------------------
# R2_ACCOUNT_ID: Cloudflare Account ID found in Cloudflare Dashboard under R2 Overview.
R2_ACCOUNT_ID=

# R2_ACCESS_KEY_ID: Cloudflare R2 S3-compatible API Token Access Key ID.
R2_ACCESS_KEY_ID=

# R2_SECRET_ACCESS_KEY: Cloudflare R2 S3-compatible API Token Secret Access Key.
R2_SECRET_ACCESS_KEY=

# R2_BUCKET_NAME: Cloudflare R2 bucket name where WebP icons are uploaded.
R2_BUCKET_NAME=grouplinks-assets

# R2_PUBLIC_DOMAIN: Public CDN custom domain serving the assets (defaults to https://cdn.grouplinks.app).
R2_PUBLIC_DOMAIN=https://cdn.grouplinks.app
